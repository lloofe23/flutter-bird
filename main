<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Flappy Game</title>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #70c5ce;
      touch-action: manipulation;
      font-family: Arial, sans-serif;
    }

    canvas {
      display: block;
      margin: 0 auto;
      background: #70c5ce;
    }
  </style>
</head>
<body>
<canvas id="gameCanvas"></canvas>

<script>
const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

function resizeCanvas() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
resizeCanvas();
window.addEventListener("resize", resizeCanvas);

const birdImg = new Image();
birdImg.src = "https://codehs.com/uploads/fdda32db51f94020b16e390112edef9a";

let bird = {
  x: 90,
  y: canvas.height / 2,
  size: 50,
  velocity: 0
};

let gravity = 0.4;
let flapStrength = -7;

let pipes = [];
let score = 0;
let gameOver = false;

let pipeSpeed = 4;
let pipeWidth = canvas.width * 0.16;
let groundHeight = canvas.height * 0.12;

function random(min, max) {
  return Math.random() * (max - min) + min;
}

function createPipe() {
  pipeWidth = canvas.width * 0.16;
  groundHeight = canvas.height * 0.12;

  let difficulty = Math.floor(score / 5);

  let minGap = canvas.height * 0.24 - difficulty * 5;
  let maxGap = canvas.height * 0.34 - difficulty * 5;

  minGap = Math.max(minGap, canvas.height * 0.18);
  maxGap = Math.max(maxGap, canvas.height * 0.24);

  let gapHeight = random(minGap, maxGap);
  let gapY = random(80, canvas.height - groundHeight - gapHeight - 80);

  let minSpacing = canvas.width * 0.4;
  let maxSpacing = canvas.width * 0.7;

  pipes.push({
    x: canvas.width + random(minSpacing, maxSpacing),
    gapY: gapY,
    gapHeight: gapHeight,
    scored: false
  });
}

function setupPipes() {
  pipes = [];
  let startX = canvas.width + 100;

  for (let i = 0; i < 3; i++) {
    let gapHeight = random(canvas.height * 0.24, canvas.height * 0.34);
    let gapY = random(80, canvas.height - groundHeight - gapHeight - 80);

    pipes.push({
      x: startX,
      gapY: gapY,
      gapHeight: gapHeight,
      scored: false
    });

    startX += random(canvas.width * 0.4, canvas.width * 0.7);
  }
}

function drawBackground() {
  ctx.fillStyle = "#70c5ce";
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  drawCloud(60, 80);
  drawCloud(canvas.width * 0.55, 130);
  drawCloud(canvas.width * 0.8, 70);

  ctx.fillStyle = "#deb887";
  ctx.fillRect(0, canvas.height - groundHeight, canvas.width, groundHeight);

  ctx.fillStyle = "#50c846";
  ctx.fillRect(0, canvas.height - groundHeight, canvas.width, 12);
}

function drawCloud(x, y) {
  ctx.fillStyle = "white";
  ctx.beginPath();
  ctx.arc(x, y, 22, 0, Math.PI * 2);
  ctx.arc(x + 28, y - 8, 28, 0, Math.PI * 2);
  ctx.arc(x + 58, y, 22, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillRect(x - 2, y, 65, 28);
}

function drawBird() {
  ctx.drawImage(birdImg, bird.x, bird.y, bird.size, bird.size);
}

function drawPipes() {
  for (let pipe of pipes) {
    drawPipe(pipe.x, 0, pipeWidth, pipe.gapY, true);
    drawPipe(
      pipe.x,
      pipe.gapY + pipe.gapHeight,
      pipeWidth,
      canvas.height - groundHeight - (pipe.gapY + pipe.gapHeight),
      false
    );
  }
}

function drawPipe(x, y, width, height, isTop) {
  ctx.fillStyle = "#006400";
  ctx.fillRect(x - 4, y, width + 8, height);

  ctx.fillStyle = "#00b400";
  ctx.fillRect(x, y, width, height);

  ctx.fillStyle = "#50e650";
  ctx.fillRect(x + 10, y, 10, height);

  let capHeight = 26;
  let capWidth = width + 20;
  let capY = isTop ? y + height - capHeight : y;

  ctx.fillStyle = "#006400";
  ctx.fillRect(x - 14, capY - 4, capWidth + 8, capHeight + 8);

  ctx.fillStyle = "#00c800";
  ctx.fillRect(x - 10, capY, capWidth, capHeight);

  ctx.fillStyle = "#64ff64";
  ctx.fillRect(x + 5, capY, 12, capHeight);
}

function drawScore() {
  ctx.fillStyle = "white";
  ctx.fillRect(12, 12, 135, 42);

  ctx.strokeStyle = "black";
  ctx.lineWidth = 2;
  ctx.strokeRect(12, 12, 135, 42);

  ctx.fillStyle = "black";
  ctx.font = "24px Arial";
  ctx.fillText("Score: " + score, 24, 42);
}

function updateBird() {
  bird.velocity += gravity;
  bird.y += bird.velocity;
}

function updatePipes() {
  let currentSpeed = pipeSpeed + Math.floor(score / 6) * 0.4;
  currentSpeed = Math.min(currentSpeed, 7);

  for (let pipe of pipes) {
    pipe.x -= currentSpeed;

    if (!pipe.scored && pipe.x + pipeWidth < bird.x) {
      score++;
      pipe.scored = true;
    }
  }

  if (pipes.length > 0 && pipes[0].x + pipeWidth < -50) {
    pipes.shift();

    let lastPipe = pipes[pipes.length - 1];
    let spacing = random(canvas.width * 0.4, canvas.width * 0.7);

    let difficulty = Math.floor(score / 5);
    let minGap = Math.max(canvas.height * 0.24 - difficulty * 5, canvas.height * 0.18);
    let maxGap = Math.max(canvas.height * 0.34 - difficulty * 5, canvas.height * 0.24);

    let gapHeight = random(minGap, maxGap);
    let gapY = random(80, canvas.height - groundHeight - gapHeight - 80);

    pipes.push({
      x: lastPipe.x + spacing,
      gapY: gapY,
      gapHeight: gapHeight,
      scored: false
    });
  }
}

function checkCollision() {
  if (bird.y <= 0 || bird.y + bird.size >= canvas.height - groundHeight) {
    gameOver = true;
  }

  for (let pipe of pipes) {
    let birdLeft = bird.x;
    let birdRight = bird.x + bird.size;
    let birdTop = bird.y;
    let birdBottom = bird.y + bird.size;

    let pipeLeft = pipe.x;
    let pipeRight = pipe.x + pipeWidth;

    let topPipeBottom = pipe.gapY;
    let bottomPipeTop = pipe.gapY + pipe.gapHeight;

    let hitsPipeX = birdRight > pipeLeft && birdLeft < pipeRight;
    let hitsTop = birdTop < topPipeBottom;
    let hitsBottom = birdBottom > bottomPipeTop;

    if (hitsPipeX && (hitsTop || hitsBottom)) {
      gameOver = true;
    }
  }
}

function drawGameOver() {
  ctx.fillStyle = "rgba(0, 0, 0, 0.45)";
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  ctx.fillStyle = "white";
  ctx.font = "40px Arial";
  ctx.textAlign = "center";
  ctx.fillText("GAME OVER", canvas.width / 2, canvas.height / 2 - 20);

  ctx.font = "20px Arial";
  ctx.fillText("Tap to Restart", canvas.width / 2, canvas.height / 2 + 25);

  ctx.textAlign = "left";
}

function flap() {
  if (gameOver) {
    restartGame();
  } else {
    bird.velocity = flapStrength;
  }
}

function restartGame() {
  bird.x = 90;
  bird.y = canvas.height / 2;
  bird.velocity = 0;
  score = 0;
  gameOver = false;
  setupPipes();
}

function gameLoop() {
  drawBackground();

  if (!gameOver) {
    updateBird();
    updatePipes();
    checkCollision();
  }

  drawPipes();
  drawBird();
  drawScore();

  if (gameOver) {
    drawGameOver();
  }

  requestAnimationFrame(gameLoop);
}

document.addEventListener("keydown", function(e) {
  if (e.code === "Space") {
    flap();
  }
});

canvas.addEventListener("mousedown", flap);
canvas.addEventListener("touchstart", function(e) {
  e.preventDefault();
  flap();
});

setupPipes();
gameLoop();
</script>
</body>
</html>
